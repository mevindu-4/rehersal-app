# Auth — set true to skip login during development (re-enable before production)
DISABLE_AUTH=true

# Supabase — Project Settings → API
# URL is https://YOUR_PROJECT_REF.supabase.co (NOT an sb_publishable_ key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM — Gemini (recommended): https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_DEMO_MODE=false

# Anthropic (alternative)
ANTHROPIC_API_KEY=

# Beyond Presence — Agent id from GET /api/bey/agents (not avatar_id)
BEY_API_KEY=
BEY_AGENT_ID=

# Embeddings for document search (use either — Jina is enough)
JINA_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_POSTHOG_KEY=

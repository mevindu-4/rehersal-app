# =============================================================================
# Rehearsal — copy to .env.local and fill values
# Full guide: docs/CONFIG.md  |  Google: docs/GOOGLE_AUTH.md  |  npm run setup:check
# =============================================================================

# --- Supabase (required) ---
# Project URL only — e.g. https://xxxx.supabase.co — NOT /rest/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL (required — OAuth redirect after Google sign-in) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth (optional in this file) ---
# Paste the same values into Supabase → Authentication → Providers → Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Beyond Presence (required for live avatar sessions) ---
BEY_API_KEY=
BEY_AGENT_ID=
BEY_WEBHOOK_SECRET=

# --- OpenAI (recommended — reconstruction, embeddings, evaluation) ---
OPENAI_API_KEY=

# --- Jina Reader (recommended — URL scraping fallback) ---
JINA_API_KEY=

# --- Optional: database CLI ---
DATABASE_URL=

# --- Optional: email, analytics, errors ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rehearsal <onboarding@resend.dev>
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
